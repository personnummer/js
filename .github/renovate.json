{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>personnummer/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Workflows pin Node to a major version only; skip minor and patch bumps",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
