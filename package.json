{
  "name": "personnummer",
  "description": "Validate Swedish personal identity numbers",
  "version": "3.2.1",
  "license": "MIT",
  "homepage": "https://github.com/personnummer/js",
  "author": {
    "name": "Rasmus Graham",
    "url": "https://github.com/rasmusbe"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/personnummer/js.git"
  },
  "bin": {
    "personnummer": "bin/personnummer"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
  },
  "scripts": {
    "build": "pine build",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "test": "pine test"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinefile/pine": "^3.0.0",
    "@types/node": "^25.9.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "is-ci": "^4.1.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "personnummer",
    "personal",
    "identity",
    "social",
    "security",
    "numbers"
  ],
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/sweidproject"
  }
}
